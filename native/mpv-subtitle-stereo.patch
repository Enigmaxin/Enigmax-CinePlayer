+// Crop geometry and texture coordinates together. No bitmap/video readback.
+static bool cine_clip(struct sub_bitmap *b, int x0, int y0, int x1, int y1,
+                      enum sub_bitmap_format format)
+{
+    if (b->dw <= 0 || b->dh <= 0 || b->w <= 0 || b->h <= 0)
+        return false;
+    int l = MPMAX(b->x, x0), t = MPMAX(b->y, y0);
+    int r = MPMIN(b->x + b->dw, x1), d = MPMIN(b->y + b->dh, y1);
+    if (r <= l || d <= t)
+        return false;
+    int sx = (int)((int64_t)(l - b->x) * b->w / b->dw);
+    int sy = (int)((int64_t)(t - b->y) * b->h / b->dh);
+    int ex = (int)((int64_t)(r - b->x) * b->w / b->dw);
+    int ey = (int)((int64_t)(d - b->y) * b->h / b->dh);
+    b->src_x += sx;
+    b->src_y += sy;
+    if (b->bitmap)
+        b->bitmap = (char *)b->bitmap + sy * b->stride +
+                    sx * (format == SUBBITMAP_BGRA ? 4 : 1);
+    b->w = ex - sx;
+    b->h = ey - sy;
+    b->x = l; b->y = t; b->dw = r - l; b->dh = d - t;
+    return b->w > 0 && b->h > 0;
+}
+
+static void cine_project_subs(struct sub_bitmaps *imgs,
+                              struct mp_osd_res full,
+                              const struct mp_osd_render_opts *opts)
+{
+    if (!imgs || !opts->cine_sub_layout || imgs->num_parts <= 0 ||
+        imgs->num_parts > 100000 ||
+        (imgs->format != SUBBITMAP_LIBASS && imgs->format != SUBBITMAP_BGRA))
+        return;
+    bool horizontal = opts->cine_sub_layout == 1;
+    int ew = full.w / (horizontal ? 2 : 1);
+    int eh = full.h / (horizontal ? 1 : 2);
+    int count = 0;
+    struct sub_bitmap *parts = talloc_array(imgs, struct sub_bitmap,
+                                           imgs->num_parts * 2);
+    for (int eye = 0; eye < 2; eye++) {
+        int ox = horizontal ? eye * ew : 0;
+        int oy = horizontal ? 0 : eye * eh;
+        int shift = lrintf(opts->cine_sub_depth * ew) * (eye ? -1 : 1);
+        for (int i = 0; i < imgs->num_parts; i++) {
+            struct sub_bitmap b = imgs->parts[i];
+            if (!opts->cine_sub_packed) {
+                b.x += ox;
+                b.y += oy;
+            }
+            if (!cine_clip(&b, ox, oy, ox + ew, oy + eh, imgs->format))
+                continue;
+            b.x += shift;
+            if (cine_clip(&b, ox, oy, ox + ew, oy + eh, imgs->format))
+                parts[count++] = b;
+        }
+    }
+    // The decoder-owned pixel storage is shared; only destination rectangles
+    // and a small array of texture coordinates are duplicated.
+    imgs->parts = parts;
+    imgs->num_parts = count;
+}
