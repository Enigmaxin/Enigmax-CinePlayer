+// Unlike a render option, this value never reconfigures the VO/decoder.
+static int mp_property_cine_parallax(void *ctx, struct m_property *prop,
+                                     int action, void *arg)
+{
+    MPContext *mpctx = ctx;
+    if (action == M_PROPERTY_SET) {
+        double v = *(double *)arg;
+        if (!isfinite(v) || fabs(v) > 0.02000001)
+            return M_PROPERTY_ERROR;
+        atomic_store_explicit(&mpctx->global->cine_parallax,
+                              (int)llround(v * 1000000), memory_order_relaxed);
+        if (mpctx->video_out)
+            vo_redraw(mpctx->video_out);
+        return M_PROPERTY_OK;
+    }
+    return m_property_double_ro(action, arg,
+        atomic_load_explicit(&mpctx->global->cine_parallax,
+                             memory_order_relaxed) / 1000000.0);
+}
